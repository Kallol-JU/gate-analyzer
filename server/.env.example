# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
# Exact frontend origin for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include a database name, e.g. /gate_cbt
# Atlas > Network Access must allow your IP (or 0.0.0.0/0 for Render).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gate_cbt?retryWrites=true&w=majority

# Secret for signing login cookies. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DAYS=7

# Optional overrides. Defaults: lax in development; none (+Secure) in production for Vercel -> Render.
# COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20

# Used only by `npm run seed` to create the first admin. Remove the password afterwards.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Integration tests only (must be a throwaway database whose name contains "test"; it is wiped):
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/gate_cbt_test
