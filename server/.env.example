NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/prepgate

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_DAYS=7

# Optional first-admin seed credentials
ADMIN_NAME=PrepGate Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-before-seeding

# Optional: enable Gemini-powered question draft generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_RETRIES=2
AI_CHUNK_SIZE=5
AI_MAX_BATCH_QUESTIONS=10
AI_DAILY_QUESTION_LIMIT=100
AI_VERIFY_ENABLED=true

LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
